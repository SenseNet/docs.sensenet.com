# Copy this file to .env and fill in the values before starting the container.
#
#   cp .env.example .env
#
# All variables are optional – the site builds without them, but search and
# analytics features will be disabled.

# ── Algolia search ────────────────────────────────────────────────────────────
GATSBY_ALGOLIA_APP_ID=
GATSBY_ALGOLIA_SEARCH_KEY=
GATSBY_ALGOLIA_ADMIN_KEY=

# ── Google Tag Manager ──────────────────────────────────────────────────────
GOOGLE_TAG_MANAGER_ID=

# ── Segment analytics ─────────────────────────────────────────────────────────
SEGMENT_PRODUCTION_WRITE_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# Port exposed by `gatsby serve` inside the container (default: 9000).
# Change the host-side mapping in docker-compose.yml instead of this.
# PORT=9000

# ── .env file path override ───────────────────────────────────────────────────
# Path to the .env file read by the entrypoint (default: /app/.env).
# Override only if you mount the file at a different location.
# ENV_FILE=/app/.env
